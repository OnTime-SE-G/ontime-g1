#define TINY_GSM_MODEM_SIM800
#include <TinyGsmClient.h>
#include <PubSubClient.h>
#include <SoftwareSerial.h>
#include <TinyGPS++.h>

// ── Config ─────────────────────────────────────────────────
const char APN[]       = "internet";
const char APN_USER[]  = "";
const char APN_PASS[]  = "";
const char BROKER[]    = "test.mosquitto.org";
const int  PORT        = 1883;
const char TOPIC[]     = "slk2024/nano/gps";
const char CLIENT_ID[] = "Nano_SLK_48291";
const char BUS_ID[]    = "ABC-1234";          // ← change to your bus ID
// ───────────────────────────────────────────────────────────

SoftwareSerial gsmSerial(3, 2);   // GSM  RX=3, TX=2
SoftwareSerial gpsSerial(5, 4);   // GPS  RX=5, TX=4

TinyGsm        modem(gsmSerial);
TinyGsmClient  gsmClient(modem);
PubSubClient   mqtt(gsmClient);
TinyGPSPlus    gps;

// ── GPS data ───────────────────────────────────────────────
double   lat       = 0.0;
double   lng       = 0.0;
float    speed_kmh = 0.0;
float    heading   = 0.0;
uint32_t timestamp = 0;
bool     gpsFixed  = false;

// ── Unix timestamp from GPS date+time ─────────────────────
uint32_t getUnixTimestamp(int y, int mo, int d, int h, int mi, int s) {
  // Days per month (non-leap year)
  int daysInMonth[] = {31,28,31,30,31,30,31,31,30,31,30,31};

  // Leap year correction for February
  if ((y % 4 == 0 && y % 100 != 0) || (y % 400 == 0))
    daysInMonth[1] = 29;

  // Count days from 1970 to start of given year
  uint32_t days = 0;
  for (int i = 1970; i < y; i++) {
    days += ((i % 4 == 0 && i % 100 != 0) || (i % 400 == 0)) ? 366 : 365;
  }

  // Add days for each month this year
  for (int i = 0; i < mo - 1; i++) {
    days += daysInMonth[i];
  }

  days += d - 1;

  return days * 86400UL + h * 3600UL + mi * 60UL + s;
}

void readGPS() {
  gpsSerial.listen();
  unsigned long start = millis();
  while (millis() - start < 1000) {
    while (gpsSerial.available()) {
      gps.encode(gpsSerial.read());
    }
  }

  if (gps.location.isValid() && gps.location.age() < 2000) {
    lat       = gps.location.lat();
    lng       = gps.location.lng();
    speed_kmh = gps.speed.kmph();
    heading   = gps.course.deg();
    gpsFixed  = true;

    // Get Unix timestamp from GPS date and time
    if (gps.date.isValid() && gps.time.isValid()) {
      timestamp = getUnixTimestamp(
        gps.date.year(),
        gps.date.month(),
        gps.date.day(),
        gps.time.hour(),
        gps.time.minute(),
        gps.time.second()
      );
    }
  } else {
    gpsFixed = false;
  }
}
// ───────────────────────────────────────────────────────────

void connectGSM() {
  gsmSerial.listen();
  Serial.println("Initialising modem...");
  modem.restart();
  Serial.print("Modem: ");
  Serial.println(modem.getModemInfo());

  Serial.print("Waiting for network...");
  while (!modem.waitForNetwork()) {
    Serial.print(".");
    delay(1000);
  }
  Serial.println(" OK");

  Serial.print("Connecting to APN: ");
  Serial.println(APN);
  while (!modem.gprsConnect(APN, APN_USER, APN_PASS)) {
    Serial.print(".");
    delay(1000);
  }
  Serial.print("GPRS connected | IP: ");
  Serial.println(modem.localIP());
}

void connectMQTT() {
  gsmSerial.listen();
  mqtt.setServer(BROKER, PORT);
  Serial.print("Connecting to MQTT broker...");
  while (!mqtt.connect(CLIENT_ID)) {
    Serial.print(".");
    delay(2000);
  }
  Serial.println(" connected!");
}

void setup() {
  Serial.begin(9600);
  gsmSerial.begin(9600);
  gpsSerial.begin(9600);

  connectGSM();
  connectMQTT();
}

void loop() {
  // 1. Read GPS
  readGPS();

  // 2. Ensure MQTT connected
  gsmSerial.listen();
  if (!mqtt.connected()) connectMQTT();
  mqtt.loop();

  // 3. Only publish if GPS has a valid fix
  if (!gpsFixed) {
    Serial.print("Waiting for GPS fix... satellites: ");
    Serial.println(gps.satellites.value());
    delay(5000);
    return;
  }

  // 4. AVR-safe float conversions
  char latStr[14], lngStr[14], spdStr[8], hdgStr[8];
  dtostrf(lat,       9, 6, latStr);
  dtostrf(lng,       9, 6, lngStr);
  dtostrf(speed_kmh, 5, 1, spdStr);
  dtostrf(heading,   5, 1, hdgStr);

  // 5. Build JSON matching exact schema
  char payload[192];
  snprintf(payload, sizeof(payload),
    "{"
      "\"bus_id\":\"%s\","
      "\"lat\":%s,"
      "\"lng\":%s,"
      "\"speed_kmh\":%s,"
      "\"heading\":%s,"
      "\"timestamp\":%lu"
    "}",
    BUS_ID, latStr, lngStr, spdStr, hdgStr, timestamp
  );

  // 6. Publish
  if (mqtt.publish(TOPIC, payload, true)) {
    Serial.print("Published: ");
    Serial.println(payload);
  } else {
    Serial.println("Publish failed — reconnecting...");
    connectMQTT();
  }

  delay(5000);
}